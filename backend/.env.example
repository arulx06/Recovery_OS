APP_NAME=RecoveryOS
ENV=dev

DATABASE_URL=postgresql+psycopg2://recoveryos:recoveryos@localhost:5432/recoveryos
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=recoveryos
TASK_QUEUE_ENABLED=true
WAIT_DELAY_SECONDS=3600
NATIVE_RETRY_DELAY_SECONDS=86400
ACTION_MAX_ATTEMPTS=3
ACTION_RETRY_DELAY_SECONDS=60
ACTION_CLAIM_TIMEOUT_SECONDS=300
ACTION_JOB_TIMEOUT_SECONDS=30
MERCHANT_TIMEZONE=Asia/Kolkata

# Simulation is the default. Credentials alone never enable external calls.
RAZORPAY_API_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=replace_with_a_local_webhook_secret

LLM_API_ENABLED=false
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-3-5-haiku-latest
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_MESSAGE_DRAFT_ENABLED=true
LLM_PTP_EXTRACTION_ENABLED=true

# Adaptive recovery policy — baseline is the safe default (process restart required to change)
RECOVERY_POLICY=baseline
ADAPTIVE_POLICY_PROFILE=balanced
# Optional explicit friction weight overrides profile (float, INR-equivalent)
# ADAPTIVE_FRICTION_WEIGHT=1.0
MODEL_ARTIFACT_PATH=app/ml/artifacts/model.joblib
MODEL_MANIFEST_PATH=app/ml/artifacts/manifest.json

FRONTEND_ORIGIN=http://localhost:5173
# Optional: comma-separated for multiple deployed origins, e.g. https://demo.example.com,http://localhost:5173
# FRONTEND_ORIGIN=https://your-demo.example.com,http://localhost:5173

# Public demo safety — when true, mutation endpoints require X-Demo-Admin-Token
DEMO_ADMIN_TOKEN_ENABLED=false
DEMO_ADMIN_TOKEN=

# Development/test failure injection — never enable in production/demo
FAILURE_INJECTION_ENABLED=false

# Guard: hard limit for synthetic experiments (prevents accidental demo freeze)
EXPERIMENT_MAX_COUNT=1000

# Startup validation
ENFORCE_TEST_MODE_ONLY=true
